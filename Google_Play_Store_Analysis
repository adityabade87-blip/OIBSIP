    "import plotly.express as px\n",
    "\n",
    "sentiment_summary = (\n",
    "    reviews_with_category\n",
    "    .groupby(['Category', 'Sentiment'])\n",
    "    .size()\n",
    "    .reset_index(name='Review Count')\n",
    ")\n",
    "\n",
    "fig = px.bar(\n",
    "    sentiment_summary,\n",
    "    x='Category',\n",
    "    y='Review Count',\n",
    "    color='Sentiment',\n",
    "    barmode='group',\n",
    "    title='Interactive Review Sentiment by Category',\n",
    "    hover_data=['Sentiment', 'Review Count']\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    xaxis_tickangle=-45,\n",
    "    height=600\n",
    ")\n",
    "\n",
    "fig.show()"
