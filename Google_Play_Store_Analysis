    "def convert_size(size):\n",
    "    size = str(size).strip()\n",
    "\n",
    "    if size.endswith('M'):\n",
    "        return float(size[:-1])\n",
    "\n",
    "    elif size.endswith('k'):\n",
    "        return float(size[:-1]) / 1024\n",
    "\n",
    "    else:\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "apps['Size_MB'] = apps['Size'].apply(convert_size)\n",
